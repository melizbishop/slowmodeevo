# macOS / system cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.numba_cache/

# Virtualenvs
.venv/
venv/
env/

# Editor / IDE
.vscode/
.idea/
*.swp

# Ignore all of outputs/ except the specific XY_EvenSampled_SlowModes folder.
# Use outputs/* (not outputs/) so git can descend for the exceptions below.
outputs/*
!outputs/multispecies_slow_modes/
outputs/multispecies_slow_modes/*
!outputs/multispecies_slow_modes/global_clustering_modes/
outputs/multispecies_slow_modes/global_clustering_modes/*
!outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/
outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/*
!outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/XY_EvenSampled_SlowModes/
# Exclude states/ within the tracked folder
outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/XY_EvenSampled_SlowModes/states/

# Global file-type exclusions (images, figures, PDFs)
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.tiff
*.webp
*.pdf

# CSVs are ignored globally — re-allow them inside the tracked XY folder
*.csv
!outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/XY_EvenSampled_SlowModes/*.csv
!outputs/multispecies_slow_modes/global_clustering_modes/global_outputs/XY_EvenSampled_SlowModes/**/*.csv
